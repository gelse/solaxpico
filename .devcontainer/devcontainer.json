{
    "name": "Pico W Modbus Development",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "runArgs": [
        "--privileged"
    ],
    "remoteUser": "developer",
    "containerEnv": {
        "PICO_SERIAL": "/dev/ttyACM0"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "mhutchie.git-graph",
                "yzhang.markdown-all-in-one",
                "zoocodeorganization.zoo-code",
                "redhat.vscode-yaml"
            ],
            "settings": {
                "python.defaultInterpreterPath": "/usr/local/bin/python3",
                "python.linting.enabled": true,
                "python.linting.pylintEnabled": false,
                "python.linting.flake8Enabled": true,
                "python.linting.mypyEnabled": false,
                "python.analysis.typeCheckingMode": "off",
                "[python]": {
                    "editor.formatOnSave": true,
                    "editor.defaultFormatter": "ms-python.python",
                    "editor.tabSize": 4,
                    "editor.insertSpaces": true
                },
                "files.exclude": {
                    "**/__pycache__": true,
                    "**/.pytest_cache": true,
                    "**/*.pyc": true
                },
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    },
    "postCreateCommand": "pip install --no-cache-dir -e . 2>/dev/null || true",
    "mounts": [
        "source=${env:HOME}/.ssh,target=/home/developer/.ssh,type=bind",
        "source=${env:HOME}/.roo,target=/home/developer/.roo,type=bind",
        "source=${env:HOME}/.config/Code/User/globalStorage/zoocodeorganization.zoo-code,target=/home/developer/.vscode-server/data/User/globalStorage/zoocodeorganization.zoo-code,type=bind"
    ]
}
