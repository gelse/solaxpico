{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Flash Pico",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/flash.sh",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy Code",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/deploy.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy & Reset",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/deploy.sh && mpremote connect /dev/ttyACM0 reset",
            "dependsOn": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Serial Monitor",
            "type": "shell",
            "command": "screen /dev/ttyACM0 115200",
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Run Tests",
            "type": "shell",
            "command": "python -m pytest tests/ -v",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Modbus Test",
            "type": "shell",
            "command": "mbpoll -m tcp -a 1 -r 1 -c 8 -t 4 ${input:PicoIP} -P 502",
            "group": "none",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "PicoIP",
            "type": "promptString",
            "description": "IP address of the Pico W",
            "default": "192.168.1.100"
        }
    ]
}
